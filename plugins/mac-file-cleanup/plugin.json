{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "mac-file-cleanup",
  "version": "2026.1119.1795061071",
  "description": "Analyze Mac storage, preview file cleanup, and organize selected folders using native macOS tools.",
  "author": {
    "name": "fhdufhdu"
  },
  "homepage": "https://github.com/fhdufhdu/fhdufhdu-plugins",
  "repository": "https://github.com/fhdufhdu/fhdufhdu-plugins",
  "keywords": [
    "macos",
    "storage",
    "file-organization",
    "cleanup"
  ],
  "extensions": {
    "com.openai": {
      "requires_local_executor": true,
      "interface": {
        "displayName": "Mac 파일 정리",
        "shortDescription": "Mac 디스크 분석과 정리 미리보기",
        "longDescription": "macOS 기본 도구로 디스크 사용량을 분석하고 캐시, 오래된 로그, 설치 파일, 빌드 산출물, Docker·IDE·Xcode 같은 개발 도구 데이터의 정리 후보를 미리 봅니다. 검토한 항목을 이동하거나 휴지통으로 보낼 수 있습니다.",
        "developerName": "fhdufhdu",
        "category": "Productivity",
        "capabilities": [
          "Interactive",
          "Write"
        ],
        "websiteURL": "https://github.com/fhdufhdu/fhdufhdu-plugins",
        "defaultPrompt": [
          "다운로드 폴더에서 용량을 많이 차지하는 파일과 정리 후보를 보여줘."
        ]
      }
    }
  }
}
